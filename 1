-- ESP初始化
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        ESP:Create(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    ESP:Create(player)
end)

Players.PlayerRemoving:Connect(function(player)
    ESP:Remove(player)
end)

-- 主更新循环
RunService.RenderStepped:Connect(function()
    -- Rage/Legit互斥
    if Rage.Enabled then
        Rage:Aim()
    elseif Legit.Enabled then
        Legit:Update()
    end
    
    -- Double Tap
    DoubleTap:Update()
    
    -- Anti-Aim
    AntiAim:Update()
    
    -- ESP
    if ESP.Enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                ESP:Update(player)
            end
        end
    end
    
    -- 移动
    Movement:Update()
    
    -- 视觉
    Visuals:Apply()
    
    -- 换肤
    Skins:Apply()
end)

