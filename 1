function Window:SelectTab(tab)
    if type(tab) == "string" then
        for _, candidate in ipairs(self.Tabs) do if candidate.Name == tab then tab = candidate; break end end
    end
    assert(type(tab) == "table" and listContains(self.Tabs, tab), "Unknown tab")
    if not tab._visible then return end
    self:ClosePopup()
    local previous = self.ActiveTab
    if previous then self:_RestoreFade(previous.Page) end
    self:_RestoreFade(tab.Page)
    self.ActiveTab = tab
    for _, item in ipairs(self.Tabs) do
        local active = item == tab
        item.Page.Visible = active or item == previous
        item.Button.BackgroundTransparency = active and 0 or 1
        self:_Color(item.Label, "TextColor3", active and "Text" or "Muted", true)
        item._paintIcon(active and "Accent" or "Muted")
    end
    if previous ~= tab then
        if previous then
            previous.Page.Position = UDim2.fromOffset(0, 0)
            self:_Tween(previous.Page, {Position = UDim2.fromOffset(-6, 0)}, .14, Enum.EasingStyle.Quint)
            self:_Fade(previous.Page, false, .12, function()
                self:_RestoreFade(previous.Page)
                if self.ActiveTab ~= previous then previous.Page.Visible = false end
            end)
        end
        tab.Page.Position = UDim2.fromOffset(0, 5)
        self:_Tween(tab.Page, {Position = UDim2.fromOffset(0, 0)}, .2, Enum.EasingStyle.Quint)
        if not self._fades[self.Root] then self:_Fade(tab.Page, true, .16) end
    end
end


