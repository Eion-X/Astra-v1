-- Popover contents are built once in a hidden template. Every open reuses the same controls and values.
function Control:CreatePopover(options)
    options = options or {}
    if self.Popover then return self.Popover end
    local window = self.Window
    local offset = self.Kind == "Toggle" and -53 or (self.Kind == "Slider" or self.Kind == "Dropdown") and -157 or -14
    local button = make("TextButton", {Text = "", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5),
        Position = UDim2.new(1, offset, .5, 0), Size = UDim2.fromOffset(24, 25)}, self.Root)
    window:_Ripple(button)
    local icon = window:_Icon(button, self.Kind == "Submenu" and "ChevronRight" or "More", "Muted", 15); icon.Position = UDim2.fromOffset(4, 5)
    if self.Kind == "Submenu" then
        button.Position = UDim2.new(1, 0, .5, 0); button.Size = UDim2.fromScale(1, 1)
        icon.AnchorPoint = Vector2.new(1, .5); icon.Position = UDim2.new(1, -16, .5, 0)
    end
    local width = options.Width or 262
    local storage = make("Frame", {Visible = false, BackgroundTransparency = 1, Size = UDim2.fromOffset(width - 18, 0)}, self.Root)
    local section = newSection(window, storage, {Name = ""})
    section.Path = self.Id .. "/popup"
    section.Transient = self.Section.Transient
    self.Popover = section
    local function open()
        if self.Disabled then return end
        local height = 0
        for _, control in ipairs(section.Controls) do if control.Root.Visible then height = height + control.Root.Size.Y.Offset end end
        height = math.min(options.MaxHeight or 420, math.max(39, height))
        window:_OpenPopup(button, width, height + 48, function(frame, popup)
            local title = window:_Text(frame, options.Title or self.Text, "Text", 12)
            title.Position = UDim2.fromOffset(14, 9); title.Size = UDim2.new(1, -28, 0, 22)
            local scroll = make("ScrollingFrame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(9, 38), Size = UDim2.new(1, -18, 1, -48),
                CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2}, frame)
            window:_Color(scroll, "ScrollBarImageColor3", "Border")
            section.Root.Parent = scroll
            local delta = scroll.ZIndex + 1 - section.Root.ZIndex
            section.Root.ZIndex = section.Root.ZIndex + delta
            for _, child in ipairs(section.Root:GetDescendants()) do if child:IsA("GuiObject") then child.ZIndex = child.ZIndex + delta end end
            -- Move persistent controls BEFORE Destroy(), including with deferred Roblox signals.
            popup.BeforeClose = function()
                if storage.Parent then section.Root.Parent = storage end
            end
        end, options.Side or "Right")
    end
    self.Connect(button.Activated, open)
    function section:Open() open() end
    return section
end

