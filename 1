function Window:Search(query)
    self._query = tostring(query or "")
    self:ClosePopup()
    for _, tab in ipairs(self.Tabs) do
        for _, section in ipairs(tab.Sections) do
            local count = 0
            for _, control in ipairs(section.Controls) do
                local show = control._visible and (self._query == "" or matches(control.Text, self._query) or matches(section.Name, self._query))
                control.Root.Visible = show
                if show then count = count + 1 end
            end
            section.Root.Visible = section._visible and (count > 0 or (#section.Controls == 0 and self._query == ""))
            section:_Dividers()
        end
        for _, grid in ipairs(tab.Grids or {}) do grid:Filter(self._query ~= "" and self._query or grid.Search.Text) end
    end
end

function Section:_Dividers()
    local visible = {}
    for _, control in ipairs(self.Controls) do if control.Root.Visible then table.insert(visible, control) end end
    for i, control in ipairs(visible) do if control.Divider then control.Divider.Visible = i < #visible end end
end

