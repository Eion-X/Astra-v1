-- ========================================
-- 反作弊绕过
-- ========================================

pcall(function()
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" then return end
        if method == "FireServer" and tostring(self):lower():find("anti") then return end
        return oldNamecall(self, ...)
    end)
    
    setreadonly(mt, true)
end)

-- ========================================
-- 真正暴力的RAGE自瞄
-- ========================================

local RageAimbot = {
    CurrentTarget = nil,
    LastShotTime = 0,
    Locked = false,
}

-- 获取最佳目标
function RageAimbot:GetBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if Config.Rage.IgnoreTeam and player.Team == LocalPlayer.Team then continue end
        
        local char = player.Character
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        
        local head = char:FindFirstChild(Config.Rage.Hitbox)
        if not head then continue end
        
        -- 计算距离
        local distance = (head.Position - Camera.CFrame.Position).Magnitude
        
        -- FOV检查
        if distance > Config.Rage.FOV then continue end
        
        -- 穿墙检查（可选）
        if not Config.Rage.AutoWallbang then
            local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * distance)
            local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
            if hit and not hit:IsDescendantOf(char) then continue end
        end
        
        -- 选择最近的
        if Config.Rage.LockClosest and distance < bestScore then
            bestScore = distance
            bestTarget = player
        end
    end
    
    return bestTarget
end

-- 瞄准目标
function RageAimbot:AimAt(target)
    if not target or not target.Character then return end
    
    local head = target.Character:FindFirstChild(Config.Rage.Hitbox)
    if not head then return end
    
    local targetPos = head.Position
    
    -- 预测移动
    if Config.Rage.Prediction then
        local velocity = head.AssemblyLinearVelocity or Vector3.new()
        targetPos = targetPos + (velocity * Config.Rage.PredictionStrength)
    end
    
    -- 计算瞄准CFrame
    local aimCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    
    -- 瞬间锁定或平滑
    if Config.Rage.InstantLock or Config.Rage.Smoothness == 0 then
        Camera.CFrame = aimCFrame
    else
        Camera.CFrame = Camera.CFrame:Lerp(aimCFrame, 1 / (Config.Rage.Smoothness + 1))
    end
    
    self.Locked = true
end

-- 自动开火
function RageAimbot:AutoShoot()
    if not Config.AutoFire.Enabled then return end
    if not self.Locked then return end
    if not self.CurrentTarget then return end
    
    local currentTime = tick()
    if currentTime - self.LastShotTime < Config.AutoFire.FireRate then return end
    
    -- 方法1: 模拟鼠标点击
    if Config.AutoFire.Method == "Mouse" or Config.AutoFire.Method == "Both" then
        mouse1press()
        task.wait(0.01)
        mouse1release()
    end
    
    -- 方法2: 触发Tool
    if Config.AutoFire.Method == "Tool" or Config.AutoFire.Method == "Both" then
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
                task.wait(0.01)
                tool:Deactivate()
            end
        end
    end
    
    self.LastShotTime = currentTime
end

-- 主更新循环
function RageAimbot:Update()
    if not Config.Rage.Enabled then 
        self.Locked = false
        return 
    end
    
    -- 获取目标
    local newTarget = self:GetBestTarget()
    
    -- 切换目标
    if Config.Rage.SwitchTarget then
        if newTarget and newTarget ~= self.CurrentTarget then
            self.CurrentTarget = newTarget
        end
    else
        if not self.CurrentTarget then
            self.CurrentTarget = newTarget
        end
    end
    
    -- 瞄准
    if self.CurrentTarget then
        self:AimAt(self.CurrentTarget)
        
        -- 自动开火
        if Config.Rage.AutoShoot then
            self:AutoShoot()
        end
    else
        self.Locked = false
    end
end

