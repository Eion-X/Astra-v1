-- Rage自瞄
local Rage = {
    Enabled = false,
    FOV = 360,
    Hitbox = "Head",
    Silent = true,
    Prediction = true,
    MultiPoint = true,
}

function Rage:GetBestTarget()
    local best = nil
    local bestScore = -1
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end
        
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health <= 0 or not root then continue end
        
        local distance = (root.Position - Camera.CFrame.Position).Magnitude
        local score = (2000 - distance) + (100 - humanoid.Health)
        
        if score > bestScore then
            bestScore = score
            best = player
        end
    end
    
    return best
end

function Rage:Aim()
    if not self.Enabled then return end
    
    local target = self:GetBestTarget()
    if not target then return end
    
    local hitPos = Resolver:GetRealPosition(target) or target.Character:FindFirstChild(self.Hitbox).Position
    
    if self.Prediction then
        local part = target.Character:FindFirstChild(self.Hitbox)
        local velocity = part.AssemblyLinearVelocity or Vector3.new()
        hitPos = hitPos + (velocity * 0.165)
    end
    
    if self.MultiPoint then
        local offset = Vector3.new((math.random()-0.5)*0.65, (math.random()-0.5)*0.65, (math.random()-0.5)*0.65)
        hitPos = hitPos + offset
    end
    
    local cf = CFrame.new(Camera.CFrame.Position, hitPos)
    
    if self.Silent then
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            Camera.CFrame = cf
        end
    else
        Camera.CFrame = cf
    end
end

-- Legit自瞄
local Legit = {
    Enabled = false,
    Key = Enum.KeyCode.E,
    FOV = 80,
    Smooth = 10,
    RCS = true,
}

function Legit:Update()
    if not self.Enabled or not UserInputService:IsKeyDown(self.Key) then return end
    
    local target = self:GetTarget()
    if not target then return end
    
    local head = target.Character:FindFirstChild("Head")
    if not head then return end
    
    local targetCF = CFrame.new(Camera.CFrame.Position, head.Position)
    Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 / self.Smooth)
end

function Legit:GetTarget()
    local closest = nil
    local shortestDist = self.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end
        
        local head = player.Character:FindFirstChild("Head")
        if not head then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if onScreen then
            local mouse = UserInputService:GetMouseLocation()
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closest = player
            end
        end
    end
    
    return closest
end

