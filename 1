function Control:SetTooltip(message)
    self.Tooltip = message
    if self._tooltipWired then return self end
    self._tooltipWired = true
    local token
    local function hide()
        token = nil
        if self.Window._tooltipOwner == self then self.Window:_HideTooltip() end
    end
    self.Connect(self.Root.MouseEnter, function()
        local current = {}; token = current
        task.delay(.48, function()
            if token == current and self.Root.Parent and self.Window._visible and self.Tooltip then self.Window:_ShowTooltip(self, self.Tooltip) end
        end)
    end)
    self.Connect(self.Root.MouseLeave, hide)
    self.Connect(self.Root.InputBegan, hide)
    self.Connect(self.Root.Destroying, hide)
    return self
end

function Window:_HideTooltip()
