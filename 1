local function make(class, props, parent)
    local object = Instance.new(class)
    if object:IsA("GuiObject") then
        object.BorderSizePixel = 0
        object.ZIndex = parent and parent:IsA("GuiObject") and parent.ZIndex + 1 or 1
    end
    if object:IsA("GuiButton") then object.AutoButtonColor = false end
    for key, value in pairs(props or {}) do object[key] = value end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return make("UICorner", {CornerRadius = UDim.new(0, radius or 6)}, parent)
end

local function textLabel(parent, content, size)
    return make("TextLabel", {
        BackgroundTransparency = 1, Text = content or "", Font = FONT,
        TextSize = size or 13, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.fromScale(1, 1),
    }, parent)
end

local function scope(root)
    local connections = {}
    local cleaned = false
    local function clean()
        if cleaned then return end
        cleaned = true
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
    end
    local function connect(signal, callback)
        local connection = signal:Connect(callback)
        if cleaned then connection:Disconnect() else table.insert(connections, connection) end
        return connection
    end
    connect(root.Destroying, function() task.defer(clean) end)
    return connect, clean
end

local function copy(value)
    return type(value) == "table" and table.clone(value) or value
end

local function listContains(list, value)
    return table.find(list, value) ~= nil
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function matches(text, query)
    return string.find(string.lower(text), string.lower(query), 1, true) ~= nil
end

function Window:_Color(object, property, token, animated)
    local props = self._styles[object]
    if not props then props = {}; self._styles[object] = props end
    props[property] = token
    local value = self.Theme[token]
    if animated then
        self:_Tween(object, {[property] = value})
    else
        -- A theme change must not be overwritten by a previously running color tween.
        local running = self._tweens[object]
        if running and running[property] then running[property]:Cancel(); running[property] = nil end
        object[property] = value
    end
end

function Window:_Tween(object, props, duration, style)
    local running = self._tweens[object]
    if not running then running = {}; self._tweens[object] = running end
    for property, value in pairs(props) do
        if running[property] then running[property]:Cancel() end
        local tween = TweenService:Create(object, TweenInfo.new(self.Animations and (duration or .14) * self.AnimationSpeed or 0, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {[property] = value})
        running[property] = tween
        tween:Play()
    end
end

-- Per-instance alpha animation avoids CanvasGroup render-target limits and works with Global ZIndex.
function Window:_Fade(root, show, duration, finished)
    if not self.Animations then
        self:_RestoreFade(root)
        if finished then finished() end
        return
    end
    local state = self._fades[root]
    if not state then
        state = {Entries = {}}; self._fades[root] = state
        local objects = root:GetDescendants(); table.insert(objects, root)
        for _, object in ipairs(objects) do
            local props = {}
            if object:IsA("GuiObject") then props.BackgroundTransparency = object.BackgroundTransparency end
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                props.TextTransparency = object.TextTransparency
                props.TextStrokeTransparency = object.TextStrokeTransparency
            end
            if object:IsA("UIStroke") then props.Transparency = object.Transparency end
            if object:IsA("ScrollingFrame") then props.ScrollBarImageTransparency = object.ScrollBarImageTransparency end
            table.insert(state.Entries, {Object = object, Properties = props})
        end
        if show then for _, entry in ipairs(state.Entries) do for property in pairs(entry.Properties) do entry.Object[property] = 1 end end end
    end
    local token = {}; state.Token = token
    for _, entry in ipairs(state.Entries) do
        if entry.Object.Parent then
            local target = {}; for property, base in pairs(entry.Properties) do target[property] = show and base or 1 end
            self:_Tween(entry.Object, target, duration or .18)
        end
    end
    task.delay((duration or .18) * self.AnimationSpeed, function()
        if self._destroyed or state.Token ~= token then return end
        if show then self._fades[root] = nil end
        if finished then finished() end
    end)
end

function Window:_Surface(frame, strength)
    make("UIGradient", {Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(strength or 239, strength or 239, strength or 239))}, frame)
end

function Window:_RestoreFade(root)
    local state = self._fades[root]
    if not state then return end
    state.Token = nil
    for _, entry in ipairs(state.Entries) do
        if entry.Object.Parent then
            local running = self._tweens[entry.Object]
            for property, value in pairs(entry.Properties) do
                if running and running[property] then running[property]:Cancel(); running[property] = nil end
                entry.Object[property] = value
            end
        end
    end
    self._fades[root] = nil
end

function Window:_Shadow(frame, baseZ, radius)
    for i = 1, 4 do
        local shadow = make("Frame", {Name = "SoftShadow", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = .91,
            Position = UDim2.fromOffset(-i * 3, -i * 3 + 3), Size = UDim2.new(1, i * 6, 1, i * 6), ZIndex = baseZ}, frame)
        corner(shadow, (radius or 13) + i * 3)
    end
end

function Window:_Frame(parent, size, token, radius)
    local frame = make("Frame", {Size = size}, parent)
    self:_Color(frame, "BackgroundColor3", token)
    if radius then corner(frame, radius) end
    return frame
end

function Window:_Stroke(parent, token)
    local stroke = make("UIStroke", {Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, parent)
    self:_Color(stroke, "Color", token or "Border")
    return stroke
end

function Window:_Text(parent, content, token, size)
    local label = textLabel(parent, content, size)
    self:_Color(label, "TextColor3", token or "Text")
    return label
end

-- Vector-like icons drawn with native Frames, so the demo needs no uploaded assets.
function Window:_Icon(parent, kind, token, size)
    local holder = make("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(size or 16, size or 16)}, parent)
    local parts = {}
    local function line(x, y, w, h, rotation, round)
        local part = make("Frame", {Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h), Rotation = rotation or 0}, holder)
        if round then corner(part, round) end
        self:_Color(part, "BackgroundColor3", token or "Muted")
        table.insert(parts, {part, "BackgroundColor3"})
        return part
    end
    local function ring(x, y, w, h)
        local part = make("Frame", {BackgroundTransparency = 1, Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h)}, holder)
        corner(part, 99)
        local stroke = self:_Stroke(part, token or "Muted")
        stroke.Thickness = 1.5
        table.insert(parts, {stroke, "Color"})
    end
    if kind == "Crosshair" then
        ring(.24, .24, .52, .52)
        line(.46, .07, .08, .25); line(.46, .68, .08, .25)
        line(.07, .46, .25, .08); line(.68, .46, .25, .08)
        line(.43, .43, .14, .14, 0, 9)
    elseif kind == "Mouse" then
        line(.22, .10, .56, .80, 0, 6)
        local cut = line(.47, .09, .06, .39); self:_Color(cut, "BackgroundColor3", "Sidebar")
        local cut2 = line(.22, .47, .56, .06); self:_Color(cut2, "BackgroundColor3", "Sidebar")
        table.remove(parts); table.remove(parts)
    elseif kind == "Image" then
        local box = make("Frame", {BackgroundTransparency = 1, Position = UDim2.fromScale(.15, .18), Size = UDim2.fromScale(.70, .64)}, holder)
        corner(box, 1); local stroke = self:_Stroke(box, token or "Muted"); table.insert(parts, {stroke, "Color"})
        line(.25, .27, .15, .15, 0, 9); line(.46, .52, .36, .26, 45, 1)
    elseif kind == "Layers" then
        line(.25, .20, .5, .18, -25, 1); line(.25, .42, .5, .18, -25, 1); line(.25, .64, .5, .18, -25, 1)
    elseif kind == "Search" then
        ring(.12, .1, .53, .53); line(.60, .64, .34, .1, 45, 2)
    elseif kind == "Save" then
        line(.18, .16, .64, .68, 0, 2)
        local slit = line(.32, .23, .37, .18); self:_Color(slit, "BackgroundColor3", "Background"); table.remove(parts)
        local dot = line(.42, .56, .18, .18, 0, 9); self:_Color(dot, "BackgroundColor3", "Background"); table.remove(parts)
    elseif kind == "ChevronDown" then
        line(.25, .48, .30, .09, 45, 2); line(.45, .48, .30, .09, -45, 2)
    elseif kind == "ChevronRight" then
        line(.35, .30, .34, .09, 45, 2); line(.35, .56, .34, .09, -45, 2)
    elseif kind == "More" then
        for i = 0, 2 do line(.15 + i * .26, .43, .14, .14, 0, 9) end
    elseif kind == "Palette" then
        ring(.14, .14, .70, .70)
        line(.3, .3, .15, .15, 0, 9); line(.58, .31, .15, .15, 0, 9); line(.32, .58, .15, .15, 0, 9)
    elseif kind == "Weapon" then
        line(.08, .41, .66, .15, -8, 2); line(.68, .35, .25, .11, -8, 2)
        line(.21, .53, .18, .14, 66, 2); line(.43, .51, .09, .27, 18, 2)
        line(.08, .48, .16, .23, -35, 2)
    else
        line(.16, .22, .68, .11, 0, 2); line(.16, .48, .68, .11, 0, 2); line(.16, .74, .68, .11, 0, 2)
        line(.33, .13, .12, .29, 0, 2); line(.60, .39, .12, .29, 0, 2); line(.36, .65, .12, .29, 0, 2)
    end
    return holder, function(newToken)
        for _, part in ipairs(parts) do self:_Color(part[1], part[2], newToken, true) end
    end
end

