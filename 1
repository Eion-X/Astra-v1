function Window:Notify(options)
    options = type(options) == "string" and {Text = options} or options or {}
    if self._destroyed then return end
    local frame = self:_Frame(self.ToastHost, UDim2.fromOffset(300, 76), "Background", 11)
    frame.LayoutOrder = math.floor(os.clock() * 1000)
    self:_Surface(frame, 226); self:_Stroke(frame)
    local indicator = self:_Frame(frame, UDim2.fromOffset(3, 34), options.Type == "Error" and "Accent" or "Muted", 2)
    indicator.Position = UDim2.fromOffset(11, 14)
    local title = self:_Text(frame, options.Title or "Neverlose", "Text", 12)
    title.Font = BOLD; title.Position = UDim2.fromOffset(24, 10); title.Size = UDim2.new(1, -37, 0, 20)
    local message = self:_Text(frame, options.Text or "", "Muted", 11)
    message.Position = UDim2.fromOffset(24, 31); message.Size = UDim2.new(1, -37, 0, 31); message.TextWrapped = true
    local bar = self:_Frame(frame, UDim2.new(1, -20, 0, 2), "Accent", 2); bar.Position = UDim2.new(0, 10, 1, -5)
    local duration = math.max(.5, options.Duration or 3)
    local timer = TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)})
    timer:Play()
    self:_Fade(frame, true, .18)
    local closed = false
    local function close()
        if closed or self._destroyed or not frame.Parent then return end
        closed = true; timer:Cancel()
        self:_Fade(frame, false, .16, function() if frame.Parent then frame:Destroy() end end)
    end
    task.delay(duration, close)
    return {Close = close, Root = frame}
end

function Window:GetState()
    local appearance = {Theme = {}, Scale = self._requestedScale, Animations = self.Animations, AnimationSpeed = self.AnimationSpeed}
    for key, color in pairs(self.Theme) do appearance.Theme[key] = {color.R, color.G, color.B} end
    local state = {Version = 1, Values = {}, Appearance = appearance}
    for id, control in pairs(self.ControlsById) do
        if control.Root.Parent and control._normalize then
            local value = control:Get()
            if control.Kind == "ColorPicker" then value = {value.R, value.G, value.B}
            elseif control.Kind == "Keybind" then value = value and value.Name or false
            elseif value == nil then value = false end
            state.Values[id] = {Kind = control.Kind, Value = value, Mode = control.Mode, Opacity = control.Opacity}
        end
    end
    return state
end

function Window:ApplyState(state, silent)
    assert(type(state) == "table" and state.Version == 1 and type(state.Values) == "table", "Invalid UI state")
    local pending = {}
    local appearance = state.Appearance
    local theme = {}
    if appearance then
        assert(type(appearance) == "table" and type(appearance.Theme) == "table", "Invalid appearance")
        assert(type(appearance.Scale) == "number" and appearance.Scale > 0 and appearance.Scale < math.huge, "Invalid scale")
        assert(type(appearance.Animations) == "boolean", "Invalid animations setting")
        assert(type(appearance.AnimationSpeed) == "number" and appearance.AnimationSpeed >= .2 and appearance.AnimationSpeed <= 3, "Invalid animation speed")
        for key, value in pairs(appearance.Theme) do
            if DEFAULT[key] then
                assert(type(value) == "table" and #value == 3, "Invalid theme color")
                for _, channel in ipairs(value) do assert(type(channel) == "number" and channel >= 0 and channel <= 1, "Invalid theme channel") end
                theme[key] = Color3.new(value[1], value[2], value[3])
            end
        end
    end
    for id, entry in pairs(state.Values) do
        local c = self.ControlsById[id]
        if c and c._normalize then
            assert(type(entry) == "table" and entry.Kind == c.Kind, "Mismatched control: " .. id)
            local value = entry.Value
            if c.Kind == "ColorPicker" then
                assert(type(value) == "table" and #value == 3, "Invalid color: " .. id)
                for _, channel in ipairs(value) do assert(type(channel) == "number" and channel >= 0 and channel <= 1, "Invalid color channel") end
                value = Color3.new(value[1], value[2], value[3])
            elseif c.Kind == "Keybind" then value = value and Enum.KeyCode[value] or nil
            elseif c.Kind == "Dropdown" and value == false then value = nil end
            value = c._normalize(value)
            if entry.Mode then assert(listContains({"Always", "Hold", "Toggle", "Inverse"}, entry.Mode), "Invalid key mode") end
            if entry.Opacity ~= nil then assert(type(entry.Opacity) == "number" and entry.Opacity >= 0 and entry.Opacity <= 1, "Invalid opacity") end
            table.insert(pending, {Control = c, Value = value, Mode = entry.Mode, Opacity = entry.Opacity})
        end
    end
    -- Validation is completed for all known controls before any state changes.
    for _, item in ipairs(pending) do
        item.Control:Set(item.Value, silent ~= false)
        if item.Mode and item.Control.SetMode then item.Control:SetMode(item.Mode, silent ~= false) end
        if item.Opacity ~= nil and item.Control.SetOpacity then item.Control:SetOpacity(item.Opacity, silent ~= false) end
    end
    if appearance then
        self:SetTheme(theme); self:SetScale(appearance.Scale)
        self.AnimationSpeed = appearance.AnimationSpeed; self:SetAnimations(appearance.Animations)
    end
    return #pending
end

function Window:CaptureDefaults()
    for _, control in pairs(self.ControlsById) do
        if control._normalize then
            control:SetDefault(control:Get()); control._defaultMode = control.Mode; control._defaultOpacity = control.Opacity
        end
    end
    self._defaults = self:GetState()
    if self.Configuration and next(self.Configs) == nil then
        for _, name in ipairs(self.Configuration.Options) do self.Configs[name] = self:GetState() end
    end
    if self.Configuration and not self._configHeaderConnection then
        self._configHeaderConnection = self.Configuration:OnChanged(function(name)
            if self.Configs[name] then self:LoadConfig(name); self:Notify({Title = "配置已载入", Text = name .. " · 仅 UI 状态"}) end
        end)
    end
end

function Window:Reset() for _, control in pairs(self.ControlsById) do if control._normalize then control:Reset(true) end end end

function Window:ListConfigs()
    local names = {}; for name in pairs(self.Configs) do table.insert(names, name) end; table.sort(names); return names
end

function Window:_RefreshConfigHeader(selected)
    if not self.Configuration then return end
    self.Configuration.Options = self:ListConfigs()
    local value = selected or self.Configuration:Get()
    if not listContains(self.Configuration.Options, value) then value = self.Configuration.Options[1] end
    self.Configuration:Set(value, true)
end

function Window:SaveConfig(name)
    assert(type(name) == "string" and name:match("%S") and #name <= 120, "请输入 1–120 字节的配置名称")
    self.Configs[name] = self:GetState(); self:_RefreshConfigHeader(name)
end

function Window:LoadConfig(name)
    assert(self.Configs[name], "找不到配置")
    local count = self:ApplyState(self.Configs[name], true); self:_RefreshConfigHeader(name); return count
end

function Window:DeleteConfig(name)
    assert(self.Configs[name], "找不到配置")
    self.Configs[name] = nil; self:_RefreshConfigHeader()
end

function Window:ExportConfig(name)
    local state = name and assert(self.Configs[name], "找不到配置") or self:GetState()
    return HttpService:JSONEncode(state)
end

function Window:ImportConfig(json, name)
    local state = HttpService:JSONDecode(json)
    -- ApplyState validates atomically; importing updates UI values and can also save them under a name.
    if name then assert(type(name) == "string" and name:match("%S") and #name <= 120, "配置名称无效") end
    local count = self:ApplyState(state, true)
    if name then self:SaveConfig(name) end
    return count
end

