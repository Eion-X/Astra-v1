function Window:_Ripple(button)
    button.ClipsDescendants = true
    self.Connect(button.InputBegan, function(input)
        if not isPress(input) or not self.Animations then return end
        local point = Vector2.new(input.Position.X, input.Position.Y) - button.AbsolutePosition
        local diameter = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.7
        local ripple = self:_Frame(button, UDim2.fromOffset(0, 0), "White", 999)
        ripple.Name = "Ripple"; ripple.AnchorPoint = Vector2.new(.5, .5); ripple.Position = UDim2.fromOffset(point.X, point.Y)
        ripple.BackgroundTransparency = .8; ripple.ZIndex = button.ZIndex + 20
        self:_Tween(ripple, {Size = UDim2.fromOffset(diameter, diameter), BackgroundTransparency = 1}, .38, Enum.EasingStyle.Quint)
        task.delay(.4 * self.AnimationSpeed, function() if ripple.Parent then ripple:Destroy() end end)
    end)
end

function Window:_StartAmbient()
    if not self.Animations or not self.AmbientGradient or self._ambientTween then return end
    self.AmbientGradient.Offset = Vector2.new(-1, 0)
    self._ambientTween = TweenService:Create(self.AmbientGradient, TweenInfo.new(2.8 * self.AnimationSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(1, 0)})
    self._ambientTween:Play()
end

function Window:_StopAmbient()
    if self._ambientTween then self._ambientTween:Cancel(); self._ambientTween = nil end
end

function Window:_CloseFrom(index)
    for i = #self._popups, index, -1 do
        local popup = table.remove(self._popups, i)
        self:_RestoreFade(popup.Frame)
        if self._capturing and self._capturing.Root:IsDescendantOf(popup.Frame) then self._capturing:_CancelCapture() end
        if popup.BeforeClose then popup.BeforeClose() end
        if popup.OnClosed then popup.OnClosed() end
        popup.Frame:Destroy()
    end
    self.Overlay.Visible = #self._popups > 0
end

function Window:ClosePopup()
    self:_CloseFrom(1)
end

function Window:_OpenPopup(anchor, width, height, builder, side)
    local keep = 0
    for i, popup in ipairs(self._popups) do
        if popup.Anchor == anchor then self:_CloseFrom(i); return nil end
        if anchor:IsDescendantOf(popup.Frame) then keep = i end
    end
    self:_CloseFrom(keep + 1)
    local frame = self:_Frame(self.Overlay, UDim2.fromOffset(width, height), "Background", 13)
    frame.Name = "Popup"
    frame.Active = true
    frame.ZIndex = 100 + keep * 50
    self:_Surface(frame, 230)
    self:_Shadow(frame, frame.ZIndex - 1)
    self:_Stroke(frame)
    make("UIScale", {Scale = self.Scale.Scale}, frame)
    local popup = {Frame = frame, Anchor = anchor, Width = width, Height = height, Side = side, Connect = scope(frame)}
    table.insert(self._popups, popup)
    self.Overlay.Visible = true
    builder(frame, popup)
    self:_PositionPopups()
    local reveal = make("NumberValue", {Value = 7}, frame)
    popup.Reveal = reveal
    self:_Tween(reveal, {Value = 0}, .2, Enum.EasingStyle.Quint)
    self:_Fade(frame, true, .16)
    return popup
end

function Window:_PositionPopups()
    for i, popup in ipairs(self._popups) do
        if not popup.Anchor:IsDescendantOf(self.Gui) then self:_CloseFrom(i); return end
        local a = popup.Anchor.AbsolutePosition - self.Host.AbsolutePosition
        local as = popup.Anchor.AbsoluteSize
        local scale = self.Scale.Scale
        popup.Frame:FindFirstChildOfClass("UIScale").Scale = scale
        local pw, ph = popup.Width * scale, popup.Height * scale
        local bounds = self.Host.AbsoluteSize
        local x, y = a.X + as.X - pw, a.Y + as.Y + 6 * scale
        if popup.Side == "Right" then x = a.X + as.X + 8 * scale; y = a.Y - 8 * scale end
        if x + pw > bounds.X - 8 then x = a.X - pw - 8 * scale end
        if y + ph > bounds.Y - 8 then y = a.Y - ph - 6 * scale end
        popup.Frame.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, bounds.X - pw - 8)), math.clamp(y, 8, math.max(8, bounds.Y - ph - 8)) + (popup.Reveal and popup.Reveal.Value * scale or 0))
    end
end

