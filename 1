    end)
    return self
end

function Window:_ClampPosition()
    local size, bounds = self.Root.AbsoluteSize, self.Host.AbsoluteSize
    local centerX = self.Root.Position.X.Scale * bounds.X + self.Root.Position.X.Offset
    local centerY = self.Root.Position.Y.Scale * bounds.Y + self.Root.Position.Y.Offset
    centerX = math.clamp(centerX, size.X / 2 + 8, math.max(size.X / 2 + 8, bounds.X - size.X / 2 - 8))
    centerY = math.clamp(centerY, size.Y / 2 + 8, math.max(size.Y / 2 + 8, bounds.Y - size.Y / 2 - 8))
    self.Root.Position = UDim2.fromOffset(centerX, centerY)
end

function Window:_Fit()
    local bounds = self.Host.AbsoluteSize
    if bounds.X < 1 or bounds.Y < 1 then return end
    self._fitScale = math.max(.05, math.min(self._requestedScale, (bounds.X - 20) / self.Width, (bounds.Y - 20) / self.Height))
    self.Scale.Scale = self._fitScale * (self.Motion and self.Motion.Value or 1)
    self:_ClampPosition()
    self:_PositionPopups()
end

function Window:SetScale(value)
    assert(type(value) == "number" and value > 0, "Scale must be positive")
    self._requestedScale = value
    self:_Fit()
end

function Window:SetAnimations(enabled)
    self.Animations = enabled == true
    if not self.Animations then
        self:_StopAmbient()
        local roots = {}; for root in pairs(self._fades) do table.insert(roots, root) end
        for _, root in ipairs(roots) do self:_RestoreFade(root) end
        self.Gui.Enabled = self._visible
    else
        self:_StartAmbient()
    end
end

function Window:SetTheme(theme)
    for key, value in pairs(theme) do if DEFAULT[key] then self.Theme[key] = value end end
    for instance, props in pairs(self._styles) do
        if instance.Parent then
            local running = self._tweens[instance]
            for property, token in pairs(props) do
                if running and running[property] then running[property]:Cancel(); running[property] = nil end
                instance[property] = self.Theme[token]
            end
        end
    end
end

