local ESPObjects = {}

local function CreateESP(player)
    if ESPObjects[player] then return end
    
    local esp = {
        Highlight = Instance.new("Highlight"),
    }
    
    esp.Highlight.FillColor = Color3.fromRGB(255, 100, 100)
    esp.Highlight.FillTransparency = 0.5
    esp.Highlight.OutlineTransparency = 0
    esp.Highlight.Enabled = false
    
    ESPObjects[player] = esp
end

local function UpdateESP(player)
    if not Config.ESP.Enabled then return end
    if not player.Character then return end
    
    if not ESPObjects[player] then CreateESP(player) end
    
    local esp = ESPObjects[player]
    esp.Highlight.Parent = player.Character
    esp.Highlight.Enabled = true
    
    -- 高亮当前目标
    if Config.ESP.ShowTarget and player == RageAimbot.CurrentTarget then
        esp.Highlight.FillColor = Config.ESP.TargetColor
        esp.Highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
    else
        esp.Highlight.FillColor = Color3.fromRGB(255, 100, 100)
        esp.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    end
end

local function RemoveESP(player)
    if ESPObjects[player] then
        ESPObjects[player].Highlight:Destroy()
        ESPObjects[player] = nil
    end
end

