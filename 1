function Control:_Commit(value, silent)
    self.Value = copy(value)
    if not self._defaultCaptured then self._default = copy(value); self._defaultCaptured = true end
    if self._render then self._render() end
    if not silent then self._event:Fire(copy(value)) end
    return self
end
function Control:Get() return copy(self.Value) end
function Control:Set(value, silent)
    assert(self._normalize, "This control has no value")
    return self:_Commit(self._normalize(value), silent)
end
function Control:OnChanged(callback) return self.Changed:Connect(callback) end
function Control:SetText(value) self.Text = value; self.Label.Text = value; self.Window:Search(self.Window._query) end
function Control:SetVisible(visible)
    self._visible = visible
    if self.Section.Tab then self.Window:Search(self.Window._query) else self.Root.Visible = visible; self.Section:_Dividers() end
end
function Control:SetDisabled(disabled)
    self.Disabled = disabled
    self.Window:_Color(self.Label, "TextColor3", disabled and "Dim" or "Text")
    if disabled then
        self.Window:ClosePopup()
        if self._CancelCapture then self:_CancelCapture() end
    end
    if self._render then self._render() end
end
function Control:Destroy()
    local index = table.find(self.Section.Controls, self); if index then table.remove(self.Section.Controls, index) end
    self.Root:Destroy(); self.Section:_Dividers()
end

