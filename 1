    frame.Position = UDim2.fromOffset(math.clamp(anchor.X, 8, math.max(8, bounds.X - 258)), math.max(8, y))
    self._tooltip = frame; self._tooltipOwner = control
    self:_Fade(frame, true, .12)
end

function Control:SetDefault(value)
