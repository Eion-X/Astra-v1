function ESP:Create(player)
    if self.Objects[player] then return end
    
    local obj = {
        Highlight = Instance.new("Highlight"),
        Billboard = Instance.new("BillboardGui"),
    }
    
    obj.Highlight.FillColor = Color3.fromRGB(255, 100, 100)
    obj.Highlight.FillTransparency = 0.5
    obj.Highlight.OutlineTransparency = 0
    obj.Highlight.Enabled = false
    
    obj.Billboard.Size = UDim2.new(0, 200, 0, 50)
    obj.Billboard.StudsOffset = Vector3.new(0, 3, 0)
    obj.Billboard.AlwaysOnTop = true
    obj.Billboard.Enabled = false
    
    obj.NameLabel = Instance.new("TextLabel", obj.Billboard)
    obj.NameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    obj.NameLabel.BackgroundTransparency = 1
    obj.NameLabel.TextColor3 = Color3.new(1, 1, 1)
    obj.NameLabel.TextStrokeTransparency = 0.5
    obj.NameLabel.Font = Enum.Font.GothamBold
    obj.NameLabel.TextSize = 14
    
    obj.InfoLabel = Instance.new("TextLabel", obj.Billboard)
    obj.InfoLabel.Position = UDim2.new(0, 0, 0.5, 0)
    obj.InfoLabel.Size = UDim2.new(1, 0, 0.5, 0)
    obj.InfoLabel.BackgroundTransparency = 1
    obj.InfoLabel.TextColor3 = Color3.new(1, 1, 1)
    obj.InfoLabel.TextStrokeTransparency = 0.5
    obj.InfoLabel.Font = Enum.Font.Gotham
    obj.InfoLabel.TextSize = 12
    
    self.Objects[player] = obj
end

function ESP:Update(player)
    if not self.Enabled or not player.Character then return end
    
    local char = player.Character
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or humanoid.Health <= 0 or not root then return end
    
    if not self.Objects[player] then self:Create(player) end
    
    local obj = self.Objects[player]
    
    obj.Highlight.Parent = char
    obj.Highlight.Enabled = true
    
    obj.Billboard.Parent = root
    obj.Billboard.Enabled = true
    
    obj.NameLabel.Text = player.Name
    obj.InfoLabel.Text = string.format("HP: %d | %dm", 
        math.floor(humanoid.Health),
        math.floor((root.Position - Camera.CFrame.Position).Magnitude))
end

function ESP:Remove(player)
    if self.Objects[player] then
        self.Objects[player].Highlight:Destroy()
        self.Objects[player].Billboard:Destroy()
        self.Objects[player] = nil
    end
end

-- 移动系统
local Movement = {
    BunnyHop = false,
    Speed = false,
    SpeedValue = 30,
    Fly = false,
    FlySpeed = 50,
    BodyVel = nil,
}

function Movement:Update()
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end
    
    -- BunnyHop
    if self.BunnyHop and humanoid.FloorMaterial ~= Enum.Material.Air then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    
    -- Speed
    if self.Speed then
        humanoid.WalkSpeed = self.SpeedValue
    else
        humanoid.WalkSpeed = 16
    end
    
    -- Fly
    if self.Fly then
        if not self.BodyVel then
            self.BodyVel = Instance.new("BodyVelocity", root)
            self.BodyVel.MaxForce = Vector3.new(100000, 100000, 100000)
        end
        
        local vel = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + Camera.CFrame.LookVector * self.FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - Camera.CFrame.LookVector * self.FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - Camera.CFrame.RightVector * self.FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + Camera.CFrame.RightVector * self.FlySpeed end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, self.FlySpeed, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, self.FlySpeed, 0) end
        
        self.BodyVel.Velocity = vel
    else
        if self.BodyVel then
            self.BodyVel:Destroy()
            self.BodyVel = nil
        end
    end
end

