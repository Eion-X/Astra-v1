end

function Window:_ShowTooltip(control, message)
    self:_HideTooltip()
    local height = TextService:GetTextSize(message, 12, FONT, Vector2.new(226, 1000)).Y + 20
    local frame = self:_Frame(self.Host, UDim2.fromOffset(250, height), "Field", 8)
    frame.ZIndex = 1000; self:_Stroke(frame); self:_Shadow(frame, 999, 8)
