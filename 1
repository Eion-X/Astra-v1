    c.Min, c.Max, c.Step = options.Min or 0, options.Max or 100, options.Step or 1
    assert(c.Max > c.Min and c.Step > 0, "Slider requires Max > Min and Step > 0")
    local area = make("TextButton", {Text = "", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -62, .5, 0), Size = UDim2.new(.32, 0, 0, 28)}, c.Root)
    self.Window:_Ripple(area)
    local rail = self.Window:_Frame(area, UDim2.new(1, 0, 0, 3), "Border", 99); rail.Position = UDim2.new(0, 0, .5, -1)
    local fill = self.Window:_Frame(rail, UDim2.fromScale(0, 1), "Accent", 99)
    local thumb = self.Window:_Frame(rail, UDim2.fromOffset(12, 12), "White", 99); thumb.AnchorPoint = Vector2.new(.5, .5)
    local valueBox = make("TextBox", {Size = UDim2.fromOffset(43, 22), Text = "", Font = FONT, TextSize = 10, ClearTextOnFocus = false}, c.Root)
    corner(valueBox, 5); self.Window:_Color(valueBox, "BackgroundColor3", "Field"); self.Window:_Color(valueBox, "TextColor3", "Text")
    valueBox.AnchorPoint = Vector2.new(1, .5); valueBox.Position = UDim2.new(1, -14, .5, 0)
    self.Window:_Stroke(valueBox)
    local valueLabel = valueBox
    local decimals = math.floor(math.clamp(options.Decimals or math.ceil(-math.log10(c.Step)), 0, 4) + 0.000001)
    c._normalize = function(value)
        value = tonumber(value) or c.Min
        if value ~= value then value = c.Min end
        return math.clamp(c.Min + math.floor((value - c.Min) / c.Step + .5) * c.Step, c.Min, c.Max)
    end
    c._render = function()
        local fraction = (c.Value - c.Min) / (c.Max - c.Min)
        fill.Size = UDim2.fromScale(fraction, 1); thumb.Position = UDim2.fromScale(fraction, .5)
        if not c._editing then valueLabel.Text = options.Format and options.Format(c.Value) or string.format("%." .. decimals .. "f", c.Value) .. (options.Suffix or "") end
        valueBox.TextEditable = not c.Disabled
        self.Window:_Color(fill, "BackgroundColor3", c.Disabled and "Dim" or "Accent")
        self.Window:_Color(thumb, "BackgroundColor3", c.Disabled and "Dim" or "White")
    end
    c.Connect(valueBox.Focused, function() if not c.Disabled then c._editing = true; valueBox.Text = tostring(c.Value) end end)
    c.Connect(valueBox.FocusLost, function()
        c._editing = false
        local number = tonumber(valueBox.Text)
        if number and not c.Disabled then c:Set(number) else c._render() end
    end)
    local dragging
    local function update(input)
        if c.Disabled then return end
        local fraction = math.clamp((input.Position.X - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1), 0, 1)
        c:Set(c.Min + fraction * (c.Max - c.Min))
    end
    c.Connect(area.InputBegan, function(input) if isPress(input) and not c.Disabled then dragging = input; update(input) end end)
    c.Connect(UIS.InputChanged, function(input)
        if not dragging or not self.Window.Gui.Enabled then return end
        if input == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then update(input) end
    end)
    c.Connect(UIS.InputEnded, function(input) if input == dragging then dragging = nil end end)
    c.Connect(UIS.WindowFocusReleased, function() dragging = nil end)
    c.Connect(area.SelectionGained, function() self.Window:_Color(thumb, "BackgroundColor3", "Accent") end)
    c.Connect(area.SelectionLost, function() c._render() end)
    c.Connect(area.InputBegan, function(input)
        if c.Disabled then return end
        if input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.DPadRight then c:Set(c.Value + c.Step)
        elseif input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.DPadLeft then c:Set(c.Value - c.Step) end
    end)
    c:Set(options.Default or c.Min, true); c:SetDisabled(c.Disabled)
    return c
end

local function attachDropdown(c, button, options)
    local window = c.Window
    c.Options = table.clone(options.Options or {})
    c.Multi = options.Multi == true
    c.Button = button
    local label = window:_Text(button, "", "Text", 12)
    label.Position = UDim2.fromOffset(options.Icon and 37 or 6, 0)
    label.Size = UDim2.new(1, options.Icon and -59 or -25, 1, 0)
    local arrow = window:_Icon(button, "ChevronDown", "Muted", 13)
    arrow.AnchorPoint = Vector2.new(1, .5); arrow.Position = UDim2.new(1, -5, .5, 0)
    if options.Icon then
        local icon = window:_Icon(button, options.Icon, "Text", 16); icon.Position = UDim2.fromOffset(9, 7)
        local line = window:_Frame(button, UDim2.new(0, 1, 1, -6), "Divider"); line.Position = UDim2.fromOffset(30, 3)
    end
    c._normalize = function(value)
        if c.Multi then
            local result = {}
            for _, item in ipairs(c.Options) do if type(value) == "table" and listContains(value, item) then table.insert(result, item) end end
            return result
        end
        if value == nil then return nil end
        assert(listContains(c.Options, value), "Dropdown value must be in Options")
        return value
    end
    c._render = function()
        label.Text = c.Multi and (#c.Value > 0 and table.concat(c.Value, ", ") or options.Placeholder or "未选择") or c.Value or options.Placeholder or "未选择"
        window:_Color(label, "TextColor3", c.Disabled and "Dim" or "Text")
    end
    function c:SetOptions(items, default)
        window:ClosePopup()
        self.Options = table.clone(items)
        if default ~= nil then self:Set(default, true)
        elseif self.Multi then self:Set(self.Value, true)
        elseif not listContains(self.Options, self.Value) then self:Set(self.Options[1], true)
        else self._render() end
    end
    c.Connect(button.Activated, function()
        if c.Disabled then return end
        local searchable = options.Searchable ~= false and #c.Options > 5
        local top = searchable and 39 or 6
        local footer = c.Multi and 29 or 0
        local height = math.min(8, math.max(1, #c.Options)) * 30 + top + 6 + footer
        window:_OpenPopup(button, math.max(options.PopupWidth or 170, button.AbsoluteSize.X / window.Scale.Scale), height, function(frame, popup)
            window:_Tween(arrow, {Rotation = 180}, .18)
            popup.OnClosed = function() window:_Tween(arrow, {Rotation = 0}, .16) end
            local scroll = make("ScrollingFrame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(6, top), Size = UDim2.new(1, -12, 1, -top - 6 - footer),
                ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, frame)
            window:_Color(scroll, "ScrollBarImageColor3", "Border")
            make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, scroll)
            if #c.Options == 0 then local empty = window:_Text(scroll, "暂无选项", "Dim", 12); empty.Size = UDim2.new(1, 0, 0, 30) end
            local entries = {}
            if searchable then
                local search = make("TextBox", {Text = "", PlaceholderText = "搜索选项…", Font = FONT, TextSize = 12, ClearTextOnFocus = false,
                    Position = UDim2.fromOffset(7, 6), Size = UDim2.new(1, -14, 0, 27)}, frame)
                corner(search, 5); window:_Color(search, "BackgroundColor3", "Field"); window:_Color(search, "TextColor3", "Text"); window:_Color(search, "PlaceholderColor3", "Dim")
                popup.Connect(search:GetPropertyChangedSignal("Text"), function()
                    for _, entry in ipairs(entries) do entry.Button.Visible = matches(entry.Value, search.Text) end
                    scroll.CanvasPosition = Vector2.new(0, 0)
                end)
            end
            local function repaint()
                for _, entry in ipairs(entries) do
                    local selected = c.Multi and listContains(c.Value, entry.Value) or c.Value == entry.Value
                    entry.Check.Text = selected and "•" or ""
                    window:_Color(entry.Label, "TextColor3", selected and "Text" or "Muted")
                    entry.Button.BackgroundTransparency = selected and 0 or 1
                end
            end
            for index, value in ipairs(c.Options) do
                assert(type(value) == "string", "Dropdown Options must contain strings")
                local item = make("TextButton", {Text = "", Size = UDim2.new(1, -2, 0, 30), LayoutOrder = index, BackgroundTransparency = 1}, scroll)
                window:_Color(item, "BackgroundColor3", "Selected"); corner(item, 5)
                local itemLabel = window:_Text(item, value, "Muted", 12); itemLabel.Position = UDim2.fromOffset(8, 0); itemLabel.Size = UDim2.new(1, -32, 1, 0)
                local check = window:_Text(item, "", "Accent", 18); check.Position = UDim2.new(1, -21, 0, 0); check.Size = UDim2.fromOffset(17, 30)
                table.insert(entries, {Value = value, Button = item, Label = itemLabel, Check = check})
                popup.Connect(item.Activated, function()
                    if c.Disabled then return end
                    if c.Multi then
                        local values = c:Get(); local at = table.find(values, value)
                        if at then table.remove(values, at) else table.insert(values, value) end
                        c:Set(values); repaint()
                    else
                        c:Set(value)
                        for i, p in ipairs(window._popups) do if p == popup then window:_CloseFrom(i); break end end
                    end
                end)
                popup.Connect(item.MouseEnter, function() item.BackgroundTransparency = 0 end)
                popup.Connect(item.MouseLeave, repaint)
            end
            if c.Multi then
                for index, title in ipairs({"全选", "清空"}) do
                    local action = make("TextButton", {Text = title, Font = FONT, TextSize = 11, BackgroundTransparency = 1,
                        Position = UDim2.new((index - 1) * .5, 4, 1, -29), Size = UDim2.new(.5, -8, 0, 25)}, frame)
                    window:_Color(action, "TextColor3", "Muted")
                    popup.Connect(action.Activated, function() c:Set(index == 1 and c.Options or {}); repaint() end)
                end
            end
            repaint()
        end)
    end)
    local default = options.Default
    if default == nil then default = c.Multi and {} or c.Options[1] end
    c:Set(default, true); c:SetDisabled(c.Disabled)
    return c
end

